# ---------------------------------------------------------------------------
# Yuanfen environment variables. Copy to .env.local for local development.
# On Vercel set them under Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Launch switch: "coming-soon" (default) or "live".
# NOTE: NEXT_PUBLIC_* values are baked in at BUILD time, so after changing this
# on Vercel you must REDEPLOY (see README "Launch day").
NEXT_PUBLIC_SITE_MODE=coming-soon

# Supabase (create a FRESH project, then run supabase/schema.sql in its SQL editor).
# Project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: random string used to salt the hashed IP addresses used for rate limiting.
IP_HASH_SALT=
